{
  "schemaVersion": 4,
  "description": "Score a change, or skip the score, then review it.",
  "tracker": {
    "kind": "builtin"
  },
  "stages": [
    {
      "id": "score",
      "initial": true,
      "description": "Score the change, or skip scoring it.",
      "tracker": {
        "status": "in_progress"
      },
      "artifacts": [
        {
          "name": "change",
          "schema": {
            "type": "object",
            "required": [
              "summary"
            ],
            "properties": {
              "summary": {
                "type": "string"
              }
            }
          }
        }
      ],
      "evidence": [
        {
          "name": "score",
          "schema": {
            "type": "object",
            "required": [
              "percent"
            ],
            "properties": {
              "percent": {
                "type": "number"
              }
            }
          }
        }
      ],
      "transitions": [
        {
          "name": "scored",
          "to": "review",
          "gates": [
            {
              "type": "evidence-recorded",
              "config": {
                "name": "score"
              }
            }
          ]
        },
        {
          "name": "skip",
          "to": "review",
          "manual": true
        }
      ]
    },
    {
      "id": "review",
      "description": "A reviewer reads the score, when there is one.",
      "tracker": {
        "status": "in_review"
      },
      "work": {
        "mode": "dispatch",
        "systemPrompt": "Review the change. Rate a finding by what it would ship.\n",
        "context": {
          "inject": [
            "change",
            "score"
          ],
          "optional": [
            "score"
          ]
        }
      },
      "artifacts": [
        {
          "name": "review-notes",
          "kind": "findings",
          "reviews": "change"
        }
      ],
      "transitions": [
        {
          "name": "finish",
          "to": "done",
          "gates": [
            {
              "type": "artifact-fresh",
              "config": {
                "artifact": "review-notes",
                "recordedThisCycle": true
              }
            }
          ]
        }
      ]
    },
    {
      "id": "done",
      "terminal": true
    }
  ]
}
