{
  "tasks": {
    "check": "deno check extensions/models/*.ts extensions/models/_lib/*.ts",
    "lint": "deno lint extensions/models/",
    "fmt": "deno fmt extensions/models/ testdata/",
    "fmt:check": "deno fmt --check extensions/models/ testdata/",
    "test": "deno test --allow-read extensions/models/"
  },
  "lint": {
    "rules": {
      "exclude": ["no-import-prefix"]
    }
  },
  "imports": {
    "zod": "npm:zod@4.3.6",
    "@cfworker/json-schema": "npm:@cfworker/json-schema@4.1.1",
    "cel-js": "npm:@marcbachmann/cel-js@7.6.1",
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/yaml": "jsr:@std/yaml@1.0.10"
  }
}
