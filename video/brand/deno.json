    "fmt:check": "deno fmt --check extensions/models/ .claude/skills/ scripts/",
    "test": "deno test --allow-read --allow-write --allow-env extensions/models/",
    "embed-assets": "deno run --allow-read --allow-write scripts/embed_assets.ts"
  },
  "lint": {
    "rules": {
      "exclude": ["no-import-prefix"]
    }
  },
  "imports": {
    "zod": "npm:zod@4.6.7",
    "qrcode-generator": "npm:qrcode-generator@2.0.4"
  }
}
